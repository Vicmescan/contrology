---
// Calendario de Eversports reducido a la vista por días con "día anterior / día siguiente".
// El widget se pinta en un shadow DOM abierto: le añadimos estilos propios para quitar
// pestañas, filtros, mes y botones de semana, fijar la altura (sin saltos al cambiar de día)
// y adaptarlo al fondo de la página.
// - dark: versión para fondo negro (texto y bordes en crema).
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---
<div class="eversports-calendar" data-dark={dark ? '' : undefined}>
  <div data-eversports-widget-id="0f26e079-7106-40b7-a10b-fafe87a79277"></div>
  <script is:inline type="module" src="https://widget-static.eversports.io/loader.js" async defer></script>
</div>

<script>
  const wrap = document.querySelector('.eversports-calendar');
  const dark = wrap?.hasAttribute('data-dark');

  const baseCss = `
    /* Pestañas Horario / Precios */
    .overflow-x-auto.border-b,
    /* Filtros, mes y botones de semana */
    [data-testid="widget-container"] > :first-child,
    /* "Nosotros utilizamos Eversports" */
    [data-testid="widget-container"] > a,
    /* Vista semanal (aparece cuando el widget es ancho): siempre usamos la vista por días */
    [data-testid="widget-container"] > [class~="@4xl:flex"] {
      display: none !important;
    }

    /* Vista por días con altura fija: días arriba, botones abajo y la lista en medio.
       Así la página no salta cuando cambia el número de clases o mientras carga. */
    [data-testid="widget-container"] > [class~="@4xl:hidden"] {
      display: flex !important;
      flex-direction: column;
      height: 520px;
    }

    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :first-child,
    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :last-child {
      flex: none;
    }

    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :last-child {
      margin-top: auto;
    }

    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :not(:first-child):not(:last-child) {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      animation: contrology-fade 0.4s ease both;
    }

    /* Botones "día anterior / día siguiente" sin fondo y a todo el ancho */
    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :last-child button {
      background: transparent !important;
      flex: 1 1 0 !important;
    }

    /* Cursor de mano en todo lo que se puede pulsar (botones, días y clases) */
    button:not(:disabled),
    a {
      cursor: pointer !important;
    }

    /* Cada clase entra con un fundido al cambiar de día */
    [data-testid="widget-container"] > [class~="@4xl:hidden"] a {
      animation: contrology-fade 0.4s ease both;
    }

    /* Bloques grises de "cargando" */
    [class*="animate-pulse"] {
      visibility: hidden;
    }

    @keyframes contrology-fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    [data-testid="widget-container"] {
      padding: 0 !important;
      background: transparent !important;
    }
  `;

  // Fondo crema (como el resto de la web)
  const lightCss = `
    * { --bg-primary: #f5f2ec !important; }
  `;

  // Fondo negro: el widget sin fondo propio, texto y bordes en crema.
  const darkCss = `
    * { --bg-primary: transparent !important; }

    [data-testid="widget-container"] > [class~="@4xl:hidden"] {
      color: #f5f2ec;
    }

    /* Días de la semana y botones de día: crema sobre negro */
    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :first-child button:not([class*="btn-bg-primary"]),
    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :last-child button {
      background: transparent !important;
      color: #f5f2ec !important;
      border-color: rgba(245, 242, 236, 0.35) !important;
      box-shadow: none !important;
    }

    [data-testid="widget-container"] > [class~="@4xl:hidden"] > :last-child button:disabled {
      color: rgba(245, 242, 236, 0.35) !important;
      border-color: rgba(245, 242, 236, 0.15) !important;
    }
  `;

  const host = wrap?.querySelector('[data-eversports-widget-id]');
  const inject = () => {
    const root = host?.querySelector(':scope > div')?.shadowRoot;
    if (!root) return false;
    if (!root.querySelector('style[data-contrology]')) {
      const style = document.createElement('style');
      style.dataset.contrology = '';
      style.textContent = baseCss + (dark ? darkCss : lightCss);
      root.appendChild(style);
    }
    return true;
  };

  // El loader crea el shadow root de forma asíncrona: lo esperamos hasta 30 s.
  let tries = 0;
  const timer = setInterval(() => {
    if (inject() || ++tries > 300) clearInterval(timer);
  }, 100);
</script>
