---
// Fondo de lamas fijo, igual que la portada en su fase oscura (slats.js), sin animación:
// negro en el centro y rayas en los laterales.
---
<canvas class="side-stripes" id="side-stripes" aria-hidden="true"></canvas>

<script>
  import { drawSlats } from '../scripts/slats.js';

  const canvas = document.getElementById('side-stripes') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  // Mismo dibujo que la portada, en su fase oscura y sin animación.
  function draw() {
    const dpr = window.devicePixelRatio || 1;
    const W = window.innerWidth;
    const H = window.innerHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    drawSlats(ctx, W, H, 0);
  }

  draw();
  window.addEventListener('resize', draw, { passive: true });
</script>

<style>
  .side-stripes {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
</style>
