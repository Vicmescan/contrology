---
import Base from '../../layouts/Base.astro';
import '../../styles/blog.css';
import '../../styles/pages.css';
---
<Base
  title="Contact — Contrology Studio Berlin"
  description="Get in touch with Contrology Studio Berlin, classical Pilates in Kreuzberg."
  bodyClass="blog"
>
<main>
  <small>Contact</small>
  <h1>Contact</h1>
  <p>For everything that isn't a reservation.</p>
  <form>
    <textarea placeholder="Message" rows="5"></textarea>
    <input type="email" placeholder="Email">
    <button type="submit" class="btn-send">Send</button>
  </form>
</main>
</Base>
