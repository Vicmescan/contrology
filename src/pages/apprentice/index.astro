---
import Base from '../../layouts/Base.astro';
import '../../styles/blog.css';
import '../../styles/pages.css';

const experience = ['Under 1 year', '1–3 years', '3+ years', 'I already teach'];
---
<Base
  title="Apprentice — Contrology Studio Berlin"
  description="Classical Pilates formation at Contrology Studio Berlin. Three to five years. Not a certification."
  bodyClass="blog"
>
<main>
  <div class="apprentice-inner">
    <div>
      <small>Apprentice</small>
      <h1>Time is<br>the method.</h1>
      <p>Three to five years.<br>Not a certification. A formation.</p>
    </div>

    <form class="apply-form">
      <small>Application</small>

      <label class="apply-field">
        <span class="apply-label"><span class="apply-num">01</span>Name</span>
        <input type="text" name="name" autocomplete="name" required>
      </label>

      <label class="apply-field">
        <span class="apply-label"><span class="apply-num">02</span>Email</span>
        <input type="email" name="email" autocomplete="email" required>
      </label>

      <fieldset class="apply-field">
        <legend class="apply-label"><span class="apply-num">03</span>Your practice</legend>
        <div class="apply-options">
          {experience.map((option) => (
            <label class="apply-option">
              <input type="radio" name="experience" value={option} required>
              <span>{option}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="apply-field">
        <span class="apply-label"><span class="apply-num">04</span>Why this path?</span>
        <textarea name="motivation" rows="4" required></textarea>
      </label>

      <button type="submit" class="apply-submit">Apply →</button>
    </form>
  </div>
</main>
</Base>
