---
import Base from '../../layouts/Base.astro';
import ReserveButton from '../../components/ReserveButton.astro';
import '../../styles/blog.css';
import { getPosts, formatDate } from '../../blog';
import { url } from '../../url';

const posts = await getPosts();
---
<Base
  title="Journal — Contrology Studio Berlin"
  description="Notes on classical Pilates from Contrology Studio Berlin, Kreuzberg."
  bodyClass="blog"
>
<main>
  <small>Journal</small>
  <h1>NOTES ON<br>THE PRACTICE.</h1>

  {posts.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={url(`journal/${post.id}/`)}>
            <small><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></small>
            <h2>{post.data.title}</h2>
            {post.data.description && <p>{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  )}
</main>

<ReserveButton floating />
</Base>
